{
  "name": "app-finale-maraudes",
  "version": "1.3.0",
  "description": "Application Electron pour les maraudes",
  "main": "main.js",
  "author": "Maraudes Team",
  "license": "ISC",
  "scripts": {
    "dev:vite": "vite",
    "build": "vite build",
    "start": "electron .",
    "start:build": "npm run build && electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "test": "npm run test:all",
    "test:all": "npm run test:adp && npm run test:transmissions && npm run test:statistiques && npm run test:navigation && npm run test:formulaires && npm run test:persistance && npm run test:interface",
    "test:adp": "npm run test:adp:ajout-complete && npm run test:adp:ajout-inconnue && npm run test:adp:point-accueil",
    "test:adp:ajout-complete": "cucumber-js fonctionnalites/adp_complet/ajout_personne_complete/**/*.feature --require fonctionnalites/support/**/*.js --require fonctionnalites/adp_complet/ajout_personne_complete/steps.js",
    "test:adp:ajout-inconnue": "cucumber-js fonctionnalites/adp_complet/ajout_personne_inconnue/**/*.feature --require fonctionnalites/support/**/*.js --require fonctionnalites/adp_complet/ajout_personne_inconnue/steps.js",
    "test:adp:point-accueil": "cucumber-js fonctionnalites/adp_complet/gestion_point_accueil/**/*.feature --require fonctionnalites/support/**/*.js --require fonctionnalites/adp_complet/gestion_point_accueil/steps.js",
    "test:transmissions": "npm run test:trans:affichage && npm run test:trans:ajout-complete && npm run test:trans:ajout-minimale && npm run test:trans:modification && npm run test:trans:suppression && npm run test:trans:filtrage",
    "test:trans:affichage": "cucumber-js fonctionnalites/transmissions_complet/affichage_page/**/*.feature --require fonctionnalites/support/**/*.js --require fonctionnalites/transmissions_complet/affichage_page/steps.js",
    "test:trans:ajout-complete": "cucumber-js fonctionnalites/transmissions_complet/ajout_transmission_complete/**/*.feature --require fonctionnalites/support/**/*.js --require fonctionnalites/transmissions_complet/ajout_transmission_complete/steps.js",
    "test:trans:ajout-minimale": "cucumber-js fonctionnalites/transmissions_complet/ajout_transmission_minimale/**/*.feature --require fonctionnalites/support/**/*.js --require fonctionnalites/transmissions_complet/ajout_transmission_minimale/steps.js",
    "test:trans:modification": "cucumber-js fonctionnalites/transmissions_complet/modification_transmission/**/*.feature --require fonctionnalites/support/**/*.js --require fonctionnalites/transmissions_complet/modification_transmission/steps.js",
    "test:trans:suppression": "cucumber-js fonctionnalites/transmissions_complet/suppression_transmission/**/*.feature --require fonctionnalites/support/**/*.js --require fonctionnalites/transmissions_complet/suppression_transmission/steps.js",
    "test:trans:filtrage": "cucumber-js fonctionnalites/transmissions_complet/filtrage_par_nom/**/*.feature --require fonctionnalites/support/**/*.js --require fonctionnalites/transmissions_complet/filtrage_par_nom/steps.js",
    "test:statistiques": "npm run test:stats:jour && npm run test:stats:mois && npm run test:stats:filtrage",
    "test:stats:jour": "cucumber-js fonctionnalites/statistiques_complet/selection_periode_jour/**/*.feature --require fonctionnalites/support/**/*.js --require fonctionnalites/statistiques_complet/selection_periode_jour/steps.js",
    "test:stats:mois": "cucumber-js fonctionnalites/statistiques_complet/selection_periode_mois/**/*.feature --require fonctionnalites/support/**/*.js --require fonctionnalites/statistiques_complet/selection_periode_mois/steps.js",
    "test:stats:filtrage": "cucumber-js fonctionnalites/statistiques_complet/filtrage_par_type_intervention/**/*.feature --require fonctionnalites/support/**/*.js --require fonctionnalites/statistiques_complet/filtrage_par_type_intervention/steps.js",
    "test:navigation": "npm run test:nav:defaut && npm run test:nav:tous && npm run test:nav:adp && npm run test:nav:stats",
    "test:nav:defaut": "cucumber-js fonctionnalites/navigation_complet/affichage_onglet_par_defaut/**/*.feature --require fonctionnalites/support/**/*.js --require fonctionnalites/navigation_complet/affichage_onglet_par_defaut/steps.js",
    "test:nav:tous": "cucumber-js fonctionnalites/navigation_complet/navigation_entre_tous_onglets/**/*.feature --require fonctionnalites/support/**/*.js --require fonctionnalites/navigation_complet/navigation_entre_tous_onglets/steps.js",
    "test:nav:adp": "cucumber-js fonctionnalites/navigation_complet/navigation_vers_adp/**/*.feature --require fonctionnalites/support/**/*.js --require fonctionnalites/navigation_complet/navigation_vers_adp/steps.js",
    "test:nav:stats": "cucumber-js fonctionnalites/navigation_complet/navigation_vers_statistiques/**/*.feature --require fonctionnalites/support/**/*.js --require fonctionnalites/navigation_complet/navigation_vers_statistiques/steps.js",
    "test:formulaires": "npm run test:form:autocompletion && npm run test:form:checkboxes",
    "test:form:autocompletion": "cucumber-js fonctionnalites/formulaires_complet/autocompletion_champs/**/*.feature --require fonctionnalites/support/**/*.js --require fonctionnalites/formulaires_complet/autocompletion_champs/steps.js",
    "test:form:checkboxes": "cucumber-js fonctionnalites/formulaires_complet/selection_multiple_checkboxes/**/*.feature --require fonctionnalites/support/**/*.js --require fonctionnalites/formulaires_complet/selection_multiple_checkboxes/steps.js",
    "test:persistance": "npm run test:persist:sauvegarde && npm run test:persist:recuperation",
    "test:persist:sauvegarde": "cucumber-js fonctionnalites/persistance_complet/sauvegarde_transmission/**/*.feature --require fonctionnalites/support/**/*.js --require fonctionnalites/persistance_complet/sauvegarde_transmission/steps.js",
    "test:persist:recuperation": "cucumber-js fonctionnalites/persistance_complet/recuperation_donnees/**/*.feature --require fonctionnalites/support/**/*.js --require fonctionnalites/persistance_complet/recuperation_donnees/steps.js",
    "test:interface": "npm run test:ui:fenetre && npm run test:ui:modales",
    "test:ui:fenetre": "cucumber-js fonctionnalites/interface_complet/affichage_fenetre_maximisee/**/*.feature --require fonctionnalites/support/**/*.js --require fonctionnalites/interface_complet/affichage_fenetre_maximisee/steps.js",
    "test:ui:modales": "cucumber-js fonctionnalites/interface_complet/gestion_modales/**/*.feature --require fonctionnalites/support/**/*.js --require fonctionnalites/interface_complet/gestion_modales/steps.js",
    "playwright": "playwright test",
    "playwright:ui": "playwright test --ui",
    "playwright:report": "playwright show-report reports/playwright-report"
  },
  "keywords": [
    "electron",
    "maraudes"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@cucumber/pretty-formatter": "^2.4.1",
    "@playwright/test": "^1.56.1",
    "electron": "^27.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^7.2.4",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.maraudes.app",
    "productName": "Application Maraudes",
    "directories": {
      "output": "C:/Users/gouisa/Desktop/Application Maraudes v1.0.9"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "fonctionnalites/**/*",
      "modules/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false
    }
  }
}
